# =====================================================================
# CaseZero Detective Game — Environment Configuration Template
# =====================================================================
# IMPORTANT: Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or API keys to GitHub.
# =====================================================================

# Google Gemini AI Integration (Required for AI Suspect Interrogation & Assistant Detective)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini

# Application Security & JWT Authentication
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Defaults to local SQLite if omitted)
DATABASE_URL=sqlite:///./casezero.db

# Frontend Domain for CORS (Set to your Vercel URL in production)
FRONTEND_ORIGIN=http://localhost:5173

# Optional: MongoDB for Support Telemetry & Chat Logs (Graceful mock fallback if unavailable)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=casezero_support
